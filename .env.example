# Copy to .env and fill in real values. Never commit the real .env.

# --- Claude auth -------------------------------------------------------
# Required in Docker/production — headless containers can't do the
# interactive `claude login` OAuth flow, so the claude CLI subprocess
# authenticates via API key instead.
#
# For LOCAL dev, leave this unset: run main.py or backend/main.py directly
# on the host (not in Docker) and the claude CLI subprocess will use your
# existing `claude login` session instead.
ANTHROPIC_API_KEY=

# --- Postgres / pgvector ------------------------------------------------
# Required by docker-compose.yml's db service.
POSTGRES_USER=permits
POSTGRES_PASSWORD=
POSTGRES_DB=permits

# Only read when running main.py/backend directly on the host (local dev).
# Inside Docker, docker-compose.yml overrides this to point at the `db`
# service instead — you don't need to change it there.
# Matches docker-compose.yml's db service published on 127.0.0.1:5433
# (`docker compose up db`).
DATABASE_URL=postgres://permits:changeme@127.0.0.1:5433/permits

# --- Storage / embeddings ------------------------------------------------
# Raw fetched documents (HTML/PDF/text) — a local folder for now. Defaults
# to ./storage/raw if unset; Docker mounts this at /app/storage/raw via the
# raw-storage volume (see docker-compose.yml).
RAW_STORAGE_DIR=

# Local (no API key needed) sentence-transformers model used for pgvector
# embeddings. Must match what the Docker image pre-downloaded (Dockerfile's
# EMBEDDING_MODEL build arg) and the dimension in db/schema.sql
# (permit_chunks.embedding is vector(384) for the default model) — changing
# this requires updating both, plus re-embedding any existing rows.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
