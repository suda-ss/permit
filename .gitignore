# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Next.js
node_modules/
.next/
npm-debug.log*

# Local Claude Code trust/approval state — machine-specific, not shared.
.claude/settings.local.json

# Raw fetched documents (Docker uses the named raw-storage volume instead;
# local runs would otherwise accumulate real crawled content here).
storage/raw/*
!storage/raw/.gitkeep

# Local Postgres data (Docker uses the named pg-data volume instead).
pgdata/

# OS
.DS_Store
